---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Dupont Plomberie — Plombier à Lyon | Dépannage 7j/7",
  description = "Dupont Plomberie, votre plombier de confiance à Lyon. Dépannage urgent, installation sanitaire, rénovation salle de bain. Disponible 7j/7. Devis gratuit.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;600;700;800&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />

    <style is:global>
      :root {
        --color-primary: #1a3c6e;
        --color-primary-light: #24508f;
        --color-accent: #ffc700;
        --color-whatsapp: #25d366;
        --color-text: #1c2530;
        --color-text-light: #5b6577;
        --color-bg: #ffffff;
        --color-bg-soft: #f5f7fb;
        --max-width: 1160px;
        --radius: 16px;
        --shadow-sm: 0 2px 10px rgba(26, 60, 110, 0.08);
        --shadow-md: 0 12px 32px rgba(26, 60, 110, 0.14);
      }

      * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      html {
        scroll-behavior: smooth;
      }

      body {
        font-family: "Plus Jakarta Sans", system-ui, -apple-system, sans-serif;
        color: var(--color-text);
        background: var(--color-bg);
        line-height: 1.5;
        -webkit-font-smoothing: antialiased;
      }

      img {
        max-width: 100%;
        display: block;
      }

      a {
        text-decoration: none;
        color: inherit;
      }

      button {
        font-family: inherit;
      }

      .container {
        width: 100%;
        max-width: var(--max-width);
        margin: 0 auto;
        padding: 0 1.25rem;
      }

      .section-label {
        display: inline-block;
        color: var(--color-primary);
        background: rgba(26, 60, 110, 0.08);
        font-weight: 700;
        font-size: 0.8rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        margin-bottom: 1rem;
      }

      .section-title {
        font-size: clamp(1.6rem, 4.5vw, 2.4rem);
        font-weight: 800;
        letter-spacing: -0.02em;
        color: var(--color-primary);
        margin-bottom: 0.75rem;
      }

      .section-subtitle {
        color: var(--color-text-light);
        font-size: 1.05rem;
        max-width: 560px;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        font-weight: 700;
        font-size: 0.95rem;
        padding: 0.85rem 1.6rem;
        border-radius: 999px;
        border: none;
        cursor: pointer;
        transition: transform 0.15s ease, box-shadow 0.15s ease, background 0.15s ease;
        white-space: nowrap;
      }

      .btn:active {
        transform: scale(0.97);
      }

      .btn-accent {
        background: var(--color-accent);
        color: var(--color-primary);
        box-shadow: 0 6px 18px rgba(255, 199, 0, 0.35);
      }

      .btn-accent:hover {
        box-shadow: 0 8px 24px rgba(255, 199, 0, 0.5);
        transform: translateY(-2px);
      }

      .btn-outline {
        background: transparent;
        color: #fff;
        border: 1.5px solid rgba(255, 255, 255, 0.4);
      }

      .btn-outline:hover {
        border-color: #fff;
        background: rgba(255, 255, 255, 0.08);
      }

      .btn-primary {
        background: var(--color-primary);
        color: #fff;
        box-shadow: var(--shadow-sm);
      }

      .btn-primary:hover {
        background: var(--color-primary-light);
        transform: translateY(-2px);
      }

      /* ---------- NAV ---------- */
      .navbar {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        z-index: 100;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(10px);
        -webkit-backdrop-filter: blur(10px);
        border-bottom: 1px solid rgba(26, 60, 110, 0.08);
      }

      .navbar .container {
        display: flex;
        align-items: center;
        justify-content: space-between;
        height: 68px;
      }

      .logo {
        display: flex;
        align-items: center;
        gap: 0.5rem;
        font-weight: 800;
        font-size: 1.05rem;
        color: var(--color-primary);
        letter-spacing: -0.01em;
      }

      .logo-mark {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        background: var(--color-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .logo-mark svg {
        width: 19px;
        height: 19px;
        stroke: var(--color-accent);
      }

      .nav-call {
        display: inline-flex;
        align-items: center;
        gap: 0.45rem;
        background: var(--color-accent);
        color: var(--color-primary);
        font-weight: 700;
        font-size: 0.85rem;
        padding: 0.55rem 1rem;
        border-radius: 999px;
        box-shadow: 0 4px 14px rgba(255, 199, 0, 0.4);
        transition: transform 0.15s ease;
      }

      .nav-call:hover {
        transform: translateY(-1px);
      }

      .nav-call svg {
        width: 16px;
        height: 16px;
        flex-shrink: 0;
      }

      /* ---------- HERO ---------- */
      .hero {
        position: relative;
        background: radial-gradient(circle at 20% 20%, #234a83 0%, var(--color-primary) 45%, #122c54 100%);
        color: #fff;
        padding: 7.5rem 0 4.5rem;
        overflow: hidden;
      }

      .hero::before {
        content: "";
        position: absolute;
        inset: 0;
        background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
        background-size: 22px 22px;
        opacity: 0.5;
        pointer-events: none;
      }

      .hero::after {
        content: "";
        position: absolute;
        width: 420px;
        height: 420px;
        border-radius: 50%;
        background: rgba(255, 199, 0, 0.15);
        filter: blur(80px);
        top: -120px;
        right: -100px;
        pointer-events: none;
      }

      .hero .container {
        position: relative;
        z-index: 1;
        text-align: center;
      }

      .hero-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        background: rgba(255, 255, 255, 0.1);
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: var(--color-accent);
        font-weight: 700;
        font-size: 0.78rem;
        letter-spacing: 0.03em;
        text-transform: uppercase;
        padding: 0.4rem 0.9rem;
        border-radius: 999px;
        margin-bottom: 1.5rem;
      }

      .hero-badge .dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #4ade80;
        box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.25);
      }

      .hero h1 {
        font-size: clamp(2rem, 7vw, 3.4rem);
        font-weight: 800;
        letter-spacing: -0.03em;
        line-height: 1.12;
        margin-bottom: 1.1rem;
      }

      .hero h1 span {
        color: var(--color-accent);
      }

      .hero-subtitle {
        font-size: clamp(1rem, 2.5vw, 1.2rem);
        color: rgba(255, 255, 255, 0.82);
        max-width: 560px;
        margin: 0 auto 2.2rem;
      }

      .hero-ctas {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.9rem;
        margin-bottom: 3rem;
      }

      .hero-stats {
        display: flex;
        justify-content: center;
        gap: clamp(1.5rem, 6vw, 3.5rem);
        flex-wrap: wrap;
        border-top: 1px solid rgba(255, 255, 255, 0.14);
        padding-top: 2rem;
      }

      .hero-stat strong {
        display: block;
        font-size: clamp(1.4rem, 4vw, 1.9rem);
        font-weight: 800;
        color: #fff;
      }

      .hero-stat span {
        font-size: 0.82rem;
        color: rgba(255, 255, 255, 0.68);
      }

      /* ---------- SERVICES ---------- */
      .services {
        padding: 5rem 0;
        background: var(--color-bg);
      }

      .section-head {
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        margin-bottom: 3rem;
      }

      .services-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 1rem;
      }

      .service-card {
        position: relative;
        border-radius: var(--radius);
        padding: 1.6rem 1.2rem;
        background: linear-gradient(155deg, #ffffff 0%, var(--color-bg-soft) 100%);
        border: 1px solid rgba(26, 60, 110, 0.08);
        box-shadow: var(--shadow-sm);
        transition: transform 0.2s ease, box-shadow 0.2s ease;
      }

      .service-card:hover {
        transform: translateY(-4px);
        box-shadow: var(--shadow-md);
      }

      .service-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 1rem;
      }

      .service-icon svg {
        width: 24px;
        height: 24px;
        stroke: var(--color-accent);
      }

      .service-card h3 {
        font-size: 1rem;
        font-weight: 700;
        color: var(--color-primary);
        margin-bottom: 0.4rem;
        letter-spacing: -0.01em;
      }

      .service-card p {
        font-size: 0.86rem;
        color: var(--color-text-light);
      }

      /* ---------- ABOUT ---------- */
      .about {
        padding: 5rem 0;
        background: var(--color-bg-soft);
      }

      .about .container {
        text-align: center;
      }

      .about-text {
        max-width: 640px;
        margin: 0 auto 3rem;
        color: var(--color-text-light);
        font-size: 1.02rem;
      }

      .about-stats {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 1rem;
        max-width: 640px;
        margin: 0 auto;
      }

      .about-stat {
        background: #fff;
        border-radius: var(--radius);
        padding: 1.6rem 0.75rem;
        box-shadow: var(--shadow-sm);
        border: 1px solid rgba(26, 60, 110, 0.06);
      }

      .about-stat strong {
        display: block;
        font-size: clamp(1.5rem, 4vw, 2rem);
        font-weight: 800;
        color: var(--color-primary);
      }

      .about-stat span {
        font-size: 0.8rem;
        color: var(--color-text-light);
        font-weight: 600;
      }

      /* ---------- TESTIMONIALS ---------- */
      .testimonials {
        padding: 5rem 0;
        background: var(--color-bg);
      }

      .testimonials-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
      }

      .testimonial-card {
        background: var(--color-bg-soft);
        border-radius: var(--radius);
        padding: 1.75rem;
        border: 1px solid rgba(26, 60, 110, 0.06);
      }

      .stars {
        display: flex;
        gap: 0.2rem;
        margin-bottom: 0.9rem;
      }

      .stars svg {
        width: 16px;
        height: 16px;
        fill: var(--color-accent);
      }

      .testimonial-quote {
        font-size: 0.98rem;
        color: var(--color-text);
        margin-bottom: 1.2rem;
        line-height: 1.6;
      }

      .testimonial-author {
        display: flex;
        align-items: center;
        gap: 0.7rem;
      }

      .author-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: linear-gradient(135deg, var(--color-primary), var(--color-primary-light));
        color: var(--color-accent);
        font-weight: 700;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .author-name {
        font-weight: 700;
        font-size: 0.88rem;
        color: var(--color-primary);
      }

      .author-loc {
        font-size: 0.78rem;
        color: var(--color-text-light);
      }

      /* ---------- CONTACT ---------- */
      .contact {
        padding: 5rem 0;
        background: var(--color-primary);
        color: #fff;
        position: relative;
        overflow: hidden;
      }

      .contact::after {
        content: "";
        position: absolute;
        width: 380px;
        height: 380px;
        border-radius: 50%;
        background: rgba(255, 199, 0, 0.1);
        filter: blur(90px);
        bottom: -140px;
        left: -100px;
      }

      .contact .container {
        position: relative;
        z-index: 1;
      }

      .contact-head {
        text-align: center;
        margin-bottom: 2.5rem;
      }

      .contact-head .section-title {
        color: #fff;
      }

      .contact-head .section-subtitle {
        color: rgba(255, 255, 255, 0.75);
        margin: 0 auto;
      }

      .contact-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 1rem;
        max-width: 640px;
        margin: 0 auto;
      }

      .contact-card {
        background: rgba(255, 255, 255, 0.06);
        border: 1px solid rgba(255, 255, 255, 0.14);
        border-radius: var(--radius);
        padding: 1.5rem;
        display: flex;
        align-items: center;
        gap: 1rem;
      }

      .contact-icon {
        width: 46px;
        height: 46px;
        border-radius: 12px;
        background: var(--color-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
      }

      .contact-icon svg {
        width: 22px;
        height: 22px;
        stroke: var(--color-primary);
      }

      .contact-card-label {
        font-size: 0.78rem;
        color: rgba(255, 255, 255, 0.6);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.03em;
      }

      .contact-card-value {
        font-weight: 700;
        font-size: 1rem;
      }

      .contact-actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.9rem;
        justify-content: center;
        margin-top: 2rem;
      }

      /* ---------- FOOTER ---------- */
      .footer {
        background: #0f2447;
        color: rgba(255, 255, 255, 0.7);
        padding: 2.5rem 0;
      }

      .footer .container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        text-align: center;
      }

      .footer .logo {
        color: #fff;
      }

      .footer .logo-mark {
        background: var(--color-accent);
      }

      .footer .logo-mark svg {
        stroke: var(--color-primary);
      }

      .footer-copy {
        font-size: 0.82rem;
      }

      /* ---------- WHATSAPP FLOAT ---------- */
      .whatsapp-float {
        position: fixed;
        bottom: 1.5rem;
        right: 1.5rem;
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--color-whatsapp);
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 6px 20px rgba(37, 211, 102, 0.5);
        z-index: 90;
        transition: transform 0.2s ease;
        animation: wa-pulse 2.4s ease-in-out infinite;
      }

      .whatsapp-float:hover {
        transform: scale(1.08);
      }

      .whatsapp-float svg {
        width: 28px;
        height: 28px;
        fill: #fff;
      }

      @keyframes wa-pulse {
        0%,
        100% {
          box-shadow: 0 6px 20px rgba(37, 211, 102, 0.5);
        }
        50% {
          box-shadow: 0 6px 24px rgba(37, 211, 102, 0.75), 0 0 0 8px rgba(37, 211, 102, 0.12);
        }
      }

      /* ---------- RESPONSIVE ---------- */
      @media (min-width: 640px) {
        .about-text {
          font-size: 1.08rem;
        }

        .testimonials-grid {
          grid-template-columns: repeat(3, 1fr);
        }
      }

      @media (min-width: 720px) {
        .contact-grid {
          grid-template-columns: repeat(2, 1fr);
        }
      }

      @media (min-width: 860px) {
        .services-grid {
          grid-template-columns: repeat(4, 1fr);
        }

        .nav-call span.nav-call-text {
          display: inline;
        }
      }

      @media (min-width: 960px) {
        .hero {
          padding: 9rem 0 5.5rem;
        }
      }
    </style>
  </body>
</html>
